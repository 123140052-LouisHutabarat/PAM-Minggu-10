CREATE TABLE Note (
    id          TEXT    PRIMARY KEY NOT NULL,
    title       TEXT    NOT NULL,
    content     TEXT    NOT NULL,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    created_at  INTEGER NOT NULL,
    updated_at  INTEGER NOT NULL
);

selectAll:
SELECT * FROM Note ORDER BY updated_at DESC;

SELECT * FROM Note WHERE id = ?;

selectFavorites:
SELECT * FROM Note WHERE is_favorite = 1 ORDER BY updated_at DESC;

search:
SELECT * FROM Note
WHERE title LIKE '%' || :query || '%'
   OR content LIKE '%' || :query || '%'
ORDER BY updated_at DESC;

insert:
INSERT INTO Note(id, title, content, is_favorite, created_at, updated_at)
VALUES (?, ?, ?, 0, ?, ?);

update:
UPDATE Note SET title = ?, content = ?, updated_at = ? WHERE id = ?;

updateFavorite:
UPDATE Note SET is_favorite = ? WHERE id = ?;

delete:
DELETE FROM Note WHERE id = ?;

DELETE FROM Note;